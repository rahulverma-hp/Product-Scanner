# Copy to Backend/.env and fill in values.

# Personalised LLM via OpenRouter (optional)
# OPENROUTER_API_KEY=sk-or-...

# Portfolio Ask Me Anything assistant — preferred key (free at aistudio.google.com/apikey).
# Falls back to OPENROUTER_API_KEY when unset.
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash

# Backup product lookup (optional)
# FOODREPO_API_KEY=

# Level 2 LoRA — OFF by default (saves RAM). Model files stay in Backend/models/ for portfolio.
# LORA_ADVICE_ENABLED=0

# Hugging Face add-ons (NER + OFF category via Robotoff). ~100MB NER model on first use.
# HF_MODELS_ENABLED=1

# Package photo scanning (Season 2 — heavy vision models)
# HF_VISION_ENABLED=1
